		{"id":"e5f24a05e48bebf9","type":"text","text":"仲裁的独立性与意思自治之间的关系","x":-840,"y":37,"width":328,"height":60},
		{"id":"89f7413604b97f4b","x":380,"y":-775,"width":250,"height":50,"type":"text","text":"几乎不涉及承认，而是执行"},
